' ============================================================
'  RAVEN Security Bot - silent launcher (project copy)
'  Launches Start_RAVEN_Bot.bat from this folder, no window.
'
'  The Desktop copy generated by setup_desktop.py is identical
'  except that the project path is baked in as an absolute path.
'
'  No log is written here: VBScript date functions are unreliable
'  on some regional settings (Now renders as '?', DatePart('mm') is
'  rejected). The bot's own UTF-8 bot.log is the audit trail.
' ============================================================
Option Explicit

Dim shell, fso, launcher
Set shell = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

launcher = fso.GetParentFolderName(WScript.ScriptFullName) & "\Start_RAVEN_Bot.bat"

If Not fso.FileExists(launcher) Then
    MsgBox "Start_RAVEN_Bot.bat not found:" & vbCrLf & launcher, vbCritical, "RAVEN"
    WScript.Quit 1
End If

shell.CurrentDirectory = fso.GetParentFolderName(launcher)
' 0 = hidden window, False = do not wait for it to finish
shell.Run """" & launcher & """", 0, False

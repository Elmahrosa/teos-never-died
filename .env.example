# ============================================================
#  RAVEN Security Bot - configuration template
#  Copy to .env and fill in the values you need.
#      cp .env.example .env
#  .env is git-ignored. Never commit real keys.
# ============================================================

# ── Telegram (required) ───────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token

# ── Access control ────────────────────────────────────────
# Your Telegram numeric user ID. Privileged commands (/buy, /sell,
# /trade_mode, /emergency_stop, /resume) are restricted to this ID.
# Leave blank to disable the gate (single-user local setups only).
ADMIN_USER_ID=
ADMIN_CHAT_ID=

# ── Local AI (primary) ────────────────────────────────────
RAVEN_MODEL=dolphin-llama3:8b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODELS=D:\OllamaModels
# Seconds before a local request is considered failed and failover starts.
# Measured on a CPU-only host (4 cores, no GPU, dolphin-llama3:8b):
#   cold model load  ~130-143s | warm 450-token prompt  ~234s
# so the default is 300. Lower it on a GPU host or a resident model.
OLLAMA_TIMEOUT=300
# How long Ollama keeps the model in RAM after the last request. Ollama's own
# default is 5m, which on a CPU-only host makes the next message wait for a
# 130-143s reload before the first token. 30m keeps it warm across a session.
# Blank this out to restore the Ollama default, or use e.g. 10m.
RAVEN_KEEP_ALIVE=30m
# Persona used for ordinary chat messages. The built-in default is short on
# purpose: the full assessment brief (~450 tokens) costs ~234s of prefill on a
# CPU-only host and forces a 4-phase report onto every message. Commands
# (/scan, /analyze, ...) always use the full brief regardless of this value.
# RAVEN_CHAT_SYSTEM_PROMPT=You are RAVEN, a security and crypto intelligence assistant. Answer directly and technically. Be concise unless detail is asked for.

# ── AI failover ───────────────────────────────────────────
# Comma-separated priority. Providers without a key are skipped.
AI_PROVIDER_PRIORITY=ollama,openai,anthropic,groq,huggingface
CLOUD_AI_TIMEOUT=45

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ── Trading ───────────────────────────────────────────────
# paper = simulated fills (default, safe)
# live  = REAL orders - only with TRADE-only exchange keys
TRADING_MODE=paper
RAVEN_PAPER_CASH=10000
MAX_POSITION_USDT=500
DAILY_LOSS_LIMIT_PCT=5

# Live trading only. Use a key with TRADE permission and NO withdrawal.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Logging ───────────────────────────────────────────────
# Log file for the bot's own UTF-8 logger (console output is unaffected)
RAVEN_LOG_FILE=bot.log

# ── Rate limiting ─────────────────────────────────────────
# Max commands per user per window (AI/exec commands are counted)
RATE_LIMIT_COUNT=10
RATE_LIMIT_WINDOW=60

# ── Intelligence ──────────────────────────────────────────
# Real breach lookups via https://haveibeenpwned.com (paid key)
HIBP_API_KEY=

# Daily briefing schedule and watchlist
DAILY_BRIEFING_TIME=08:00
DAILY_BRIEFING_KEYWORDS=ransomware,zero-day,breach,apt,cve

# ── Social media (optional) ───────────────────────────────
# Twitter/X - the only platform the bot can post to directly.
# Create an app at https://developer.twitter.com then: pip install tweepy
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# TikTok / YouTube / Instagram need approved developer apps.
# These are recorded for readiness reporting only - see /social_guide.
TIKTOK_ACCESS_TOKEN=
YOUTUBE_API_KEY=
INSTAGRAM_SESSION=

# ── Multimodal analysis (images / video / documents) ───────
# Which local Ollama model analyses images. It MUST be a vision model.
# The default text model (dolphin-llama3:8b) cannot read images - install a
# vision model first, otherwise the bot says so instead of guessing:
#     ollama pull llava
# Anything already pulled works too, e.g. llama3.2-vision, bakllava, moondream.
RAVEN_VISION_MODEL=llava
# Allow media to be sent to a cloud vision API when no local model is
# installed. Set to false to keep every upload 100% on this machine.
CLOUD_MEDIA_ANALYSIS=true
# Vision model ids, used only when the matching API key above is set.
OPENAI_VISION_MODEL=gpt-4o-mini
GROQ_VISION_MODEL=meta-llama/llama-3.2-11b-vision-preview

# ── SaaS tiers ────────────────────────────────────────────
# Where customer and usage records live. SQLite by default (created on first
# run, git-ignored). Point at PostgreSQL to run multi-instance:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/raven
# If SQLAlchemy is not installed the bot falls back to an in-memory store,
# which means tiers reset on restart - reported by /my_usage.
DATABASE_URL=
# Checkout link advertised by /upgrade. Left blank the bot says checkout is
# not configured instead of sending the user to a broken URL.
PAYMENT_CHECKOUT_URL=

# ── Payment webhook (separate service) ────────────────────
# Runs in its own process - it is NOT part of the Telegram bot:
#     python webhook_server.py
# Until DODO_WEBHOOK_SECRET is set the endpoint returns 503 and upgrades
# nothing. That is deliberate: a misconfigured webhook must never be able to
# grant free tiers.
# Dodo-Signature style HMAC-SHA256 over "<timestamp>.<raw body>".
# DODO_WEBHOOK_SECRET=
# Seconds a signed request stays valid, blocking replay of a captured payload.
PAYMENT_WEBHOOK_TOLERANCE=300
# How long a payment event id is remembered, so provider retries cannot
# credit an account twice.
PAYMENT_IDEMPOTENCY_WINDOW=86400
# Send the user an upgrade message after a payment is credited.
PAYMENT_NOTIFY_TELEGRAM=true

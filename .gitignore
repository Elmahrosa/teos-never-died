__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.env
.DS_Store
Thumbs.db
*.log
*.png
*.jpg
*.jpeg
*.exe
*.msi
.raven_sessions/
.raven_knowledge/
raven_export_*.md
# Conversation exports can contain real user chat content, not just summaries.
raven_export_*.json

# Trading state (paper balances + trade log)
raven_portfolio.json
raven_trades.json

# Voice-note scratch files. handle_voice cleans these up in a finally block,
# but os.remove fails on Windows while pydub/SpeechRecognition still hold the
# file handle, so they can survive a run.
temp_voice_*.ogg
temp_voice_*.wav

# Local env template safety
.env.example.bak

# Local Ollama storage (stale leftovers from old setup; Ollama uses OLLAMA_MODELS path)
blobs/
manifests/
metadata/

# Hand-rolled backup and splice scratch. A previous session left *.bak*,
# *.backup and sub_functions*.txt in the tree; the *.txt copies were partial
# and the splice that consumed them corrupted telegram_bot.py. Edit files in
# place and commit - do not stage these.
*.bak
*.bak2
*.backup
sub_functions*.txt
menu_functions.txt
button_callback.txt
help_menu.txt
workflow_phase5*.js

# Scratch produced by running a module directly. The perf harness in
# diagnostics.py writes these next to the code it probes.
_audit_*.py
dbg.py

# Test scratch. The suite points DATABASE_URL at a temp sqlite file, but a
# stray run against the default path would create this in the repo root.
tests/.pytest_cache/
.pytest_cache/

# SaaS data. Holds every customer record, so it must never enter git history.
raven_saas.db
raven_saas.db-journal
raven_saas.db-wal
raven_saas.db-shm
raven_test_*.db

# Media scratch space for photo/video/document analysis. Files are deleted in a
# finally block, but a crash mid-analysis can leave user uploads behind.
raven_media_tmp/

# Watchdog single-instance lock (raven_watchdog.ps1 holds it exclusively so two
# supervisors cannot both restart the bot). Runtime state, never tracked.
# The .log files it and Run_RAVEN_Persistent.bat write are already covered by
# the *.log rule above.
raven_watchdog.lock

# Catch every .env variant (.env.txt, .env.local, .env.production) rather than
# just .env. A copy of the real .env under a different suffix is the same secret
# exposure, and the plain `.env` line above does not cover it. The negation
# re-admits the template, which is the only one of these meant to be tracked.
.env*
!.env.example

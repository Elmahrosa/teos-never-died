raven_export_*.md

# Trading state (paper balances + trade log)
raven_portfolio.json
raven_trades.json

# Voice-note scratch files. handle_voice cleans these up in a finally block,
# but os.remove fails on Windows while pydub/SpeechRecognition still hold the
# file handle, so they can survive a run.
temp_voice_*.ogg
temp_voice_*.wav

# Local env template safety
.env.example.bak

# Local Ollama storage (stale leftovers from old setup; Ollama uses OLLAMA_MODELS path)
blobs/
manifests/
metadata/

# Test scratch. The suite points DATABASE_URL at a temp sqlite file, but a
# stray run against the default path would create this in the repo root.
tests/.pytest_cache/
.pytest_cache/

# SaaS data. Holds every customer record, so it must never enter git history.
raven_saas.db
raven_saas.db-journal
raven_saas.db-wal
raven_saas.db-shm
raven_test_*.db

# Media scratch space for photo/video/document analysis. Files are deleted in a
# finally block, but a crash mid-analysis can leave user uploads behind.
raven_media_tmp/
